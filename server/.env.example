PORT=5000
NODE_ENV=development

# Local MySQL example: DB_HOST=127.0.0.1, DB_PORT=3306, DB_SSL=false
# TiDB Cloud Starter example: use the host/user/password/port from its Connect panel
DB_HOST=YOUR_MYSQL_HOST
DB_PORT=4000
DB_USER=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=test
DB_SSL=true

# Generate a long random value. Never commit the real .env file.
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
CLIENT_ORIGIN=http://localhost:5173
